{
  "name": "reversa-tax",
  "private": true,
  "version": "0.3.0",
  "description": "Reversa Tax — plataforma de análise e recuperação de oportunidades de PIS/Cofins",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^3.0.2",
    "postgres": "^3.4.5"
  },
  "scripts": {
    "build": "npm run migrate && npm run seed:opportunities && npm run bootstrap:owner",
    "migrate": "node scripts/migrate.js",
    "seed:opportunities": "node scripts/seed-opportunities.js",
    "bootstrap:owner": "node scripts/bootstrap-owner.js",
    "bootstrap:legacy-users": "node scripts/bootstrap-legacy-users.js",
    "bootstrap:first-owner": "node scripts/bootstrap-first-owner.js",
    "check": "node scripts/check-runtime.js",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
